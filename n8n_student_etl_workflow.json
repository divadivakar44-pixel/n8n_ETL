      "name": "Extract from File"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nfunction cleanText(value) {\n  return String(value ?? \"\").trim();\n}\n\nfunction titleCase(value) {\n  return cleanText(value)\n    .toLowerCase()\n    .replace(/\\b[a-z]/g, c => c.toUpperCase());\n}\n\nfunction cleanPhone(value) {\n  if (value === null || value === undefined || value === \"\") {\n    return \"\";\n  }\n\n  return String(value).replace(/\\.0$/, \"\").trim();\n}\n\nfunction cleanCourse(value) {\n  const course = cleanText(value).toLowerCase();\n\n  const courses = {\n    \"ml\": \"Machine Learning\",\n    \"machine learning\": \"Machine Learning\",\n    \"python\": \"Python\",\n    \"data science\": \"Data Science\"\n  };\n\n  return courses[course] || titleCase(course);\n}\n\nreturn items.map(item => {\n  const row = item.json;\n\n  const email = cleanText(row.Email).toLowerCase();\n\n  const validEmail =\n    /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n\n  return {\n    json: {\n      Student_ID: cleanText(row.Student_ID).toUpperCase(),\n      Name: titleCase(row.Name),\n      Email: email,\n      Phone: cleanPhone(row.Phone),\n      Course: cleanCourse(row.Course),\n      Fee_Paid: cleanText(row.Fee_Paid).toLowerCase(),\n      City: titleCase(row.City),\n      Enrolled_Date: cleanText(row.Enrolled_Date),\n      Email_Valid: validEmail\n    }\n  };\n});\n"
      },
